{
    "$schema": "https://opencode.ai/config.json",
    "model": "github-copilot/gpt-5.4-mini",
    "small_model": "github-copilot/gpt-5-mini",
    "provider": {
        "opencode": {
            "whitelist": [
                "big-pickle",
                "mimo-v2-omni-free",
                "mimo-v2-pro-free",
                "minimax-m2.5-free",
                "nemotron-3-super-free",
            ]
        },
        "github-copilot": {
            "whitelist": [
                "claude-sonnet-4.6",
                "gpt-4o",
                "gpt-5-mini",
                "gpt-5.4",
                "gpt-5.4-mini",
                "gemini-3-flash-preview",
            ]
        },
        "zai-coding-plan": {
            "models": {
                "glm-5.1": {
                    "name": "GLM-5.1",
                    "limit": {
                        "context": 200000,
                        "output": 8192
                    }
                }
            },
            "whitelist": [
                "glm-5.1",
                "glm-5-turbo",
            ]
        },
    },
    "agent": {
        "build": {
            "model": "zai-coding-plan/glm-5-turbo",
            "small_model": "github-copilot/gpt-5-mini",
        },
        "plan": {
            "model": "zai-coding-plan/glm-5-turbo",
            "small_model": "github-copilot/gpt-5-mini",
        },
        "explore": {
            "model": "github-copilot/gpt-5-mini",
        },
    },
}
